# SQLite for local development. On a server use Postgres: postgresql://user:pass@host:5432/rinamas
DATABASE_URL="file:./dev.db"
# Seeded staff accounts for /admin (username "ceo" = super admin, "frontdesk" = admin). Change before deploying.
SUPERADMIN_PASSWORD="change-me"
ADMIN_PASSWORD="change-me"
# Random string used to sign the admin session cookie. 32+ characters.
SESSION_SECRET="change-me-to-a-long-random-string"
# WhatsApp dispatch number in international format, digits only.
WHATSAPP_NUMBER="233243518749"
# Public site URL, used in confirmation links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
