# Postgres everywhere. Locally: createdb rinamas (Homebrew postgresql@17). In production use a managed Postgres (Neon, Prisma Postgres, Supabase).
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/rinamas"
# Seeded staff accounts for /admin (username "ceo" = super admin, "frontdesk" = admin). Change before deploying.
# Login names are fixed by prisma/seed.mjs (not read by the app):
#   super admin (CEO, Narh Richard Mashie) -> username: ceo
#   normal admin (front desk)              -> username: frontdesk
SUPERADMIN_PASSWORD="change-me"
ADMIN_PASSWORD="change-me"
# Random string used to sign the admin session cookie. 32+ characters.
SESSION_SECRET="change-me-to-a-long-random-string"
# WhatsApp dispatch number in international format, digits only.
WHATSAPP_NUMBER="233243518749"
# Public site URL, used in confirmation links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Photo uploads. On Vercel a Blob store connected under Storage sets BLOB_STORE_ID (private, OIDC) or BLOB_READ_WRITE_TOKEN (public) automatically.
# Locally leave both unset and uploads are written to public/img.
# BLOB_STORE_ID=
